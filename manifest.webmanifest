{
  "name": "MoodRabbit",
  "short_name": "MoodRabbit",
  "description": "A calm habit and mood tracker for routines, check-ins, and wellbeing patterns.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
